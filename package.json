{
    "name": "@fr0st/component",
    "version": "2.1.2",
    "private": false,
    "description": "Native JavaScript stateful web components with reactive bindings, slots, shadow DOM, suspense, and HTML template autoloading.",
    "keywords": [
        "bindings",
        "components",
        "custom-elements",
        "frost",
        "html",
        "reactive",
        "shadow-dom",
        "slots",
        "templating",
        "web-components"
    ],
    "homepage": "https://github.com/frost-js/component",
    "bugs": {
        "url": "https://github.com/frost-js/component/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frost-js/component.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-component.esm.js",
            "default": "./dist/frost-component.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-component.esm.js",
    "jsdelivr": "./dist/frost-component.min.js",
    "unpkg": "./dist/frost-component.min.js",
    "module": "./dist/frost-component.esm.js",
    "files": [
        "dist",
        "examples",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode umd",
        "lint": "eslint",
        "test": "npm run build && npm run test:browser",
        "test:browser": "playwright test --forbid-only",
        "test:coverage": "playwright test --config=playwright.coverage.config.js --forbid-only"
    },
    "dependencies": {
        "@fr0st/state": "^1.1.3"
    },
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.3",
        "@playwright/test": "^1.62.1",
        "eslint": "^10.9.1",
        "monocart-reporter": "^2.12.6",
        "vite": "^8.2.2"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
